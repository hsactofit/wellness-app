<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app API runs on the Mac's LAN HTTP address during the local demo. -->
    <base-config cleartextTrafficPermitted="true" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
